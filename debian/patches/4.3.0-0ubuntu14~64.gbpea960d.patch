+    for (Key key = 0; key < count; ++key) {
+      problem.addCost(HessianFactor(key, Matrix::Ones(1, 1),
+                                    Vector::Constant(1, key + 1), 0));
+      problem.addConstraint(LinearConstraint::Equal(
+          JacobianFactor(key, scale * Matrix::Ones(1, 1), (key + 1) % count,
