+      });
+  EXPECT(hasAnchorConstraint);
+  // Each Frobenius edge costs 2*(1-cos(delta)); the total winding is zero.
+  CheckFixedVariables(problem, fixed, 2.0 * kCount * (1.0 - std::cos(kDelta)),
