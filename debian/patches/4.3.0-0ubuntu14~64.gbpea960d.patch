+      const Vector negative =
+          solve(calibration, scale - step, noise).at<Vector>(kState);
+      EXPECT_DOUBLES_EQUAL(expectedScale,
+                           stateCotangent.dot(positive - negative) / (2 * step),
+                           1e-8);
+    }
+  }
