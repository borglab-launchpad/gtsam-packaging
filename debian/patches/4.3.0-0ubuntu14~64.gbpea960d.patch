+    "fig.add_scatter3d(x=[x_true[0]], y=[x_true[1]], z=[x_true[2]], mode=\"markers\", marker=dict(size=7), name=\"True Position\")\n",
+    "fig.add_scatter3d(x=[x_initial[0]], y=[x_initial[1]], z=[x_initial[2]], mode=\"markers\", marker=dict(size=7), name=\"Initial Estimate\")\n",
