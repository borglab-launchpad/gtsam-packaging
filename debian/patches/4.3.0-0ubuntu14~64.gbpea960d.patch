+    "if sdp_position is not None:\n",
+    "    fig.add_scatter3d(x=[sdp_position[0]], y=[sdp_position[1]], z=[sdp_position[2]], mode=\"markers\", marker=dict(size=7, symbol=\"cross\"), name=\"SDP\")\n",
