+AugmentedLagrangianParams::shared_ptr Params() {
+  auto p = std::make_shared<AugmentedLagrangianParams>();
+  p->absoluteViolationTolerance = p->absoluteStationarityTolerance = 1e-9;
+  p->maxIterations = 40;
+  p->storeOptProgress = true;
+  return p;
+}
