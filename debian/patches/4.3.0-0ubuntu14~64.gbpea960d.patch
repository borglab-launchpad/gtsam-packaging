+  CHECK_EXCEPTION(Traits::QcqpConstraints<2>(), std::invalid_argument);
+  CHECK_EXCEPTION(Traits::FromQcqpValue<2>(Matrix::Zero(5, 1)),
+                  std::invalid_argument);
+}
