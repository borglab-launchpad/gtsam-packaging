+  CHECK(result.second.converged);
+  CHECK(assert_equal(Vector1(2.0), result.first.at<Vector>(10), 1e-9));
+  CHECK(assert_equal(Vector1(-1.0), result.first.at<Vector>(30), 1e-9));
+  CHECK(result.second.iterations == 2);
