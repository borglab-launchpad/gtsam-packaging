+    initial = Values();
+    initial.insert(key, [20; -10]);
+    solver = ActiveSetSolver(problem, params);
+    values = solver.optimize(initial);
+    CHECK('Infeasible dual start', norm(values.atVector(key) - [1; 3]) < 1e-7);
