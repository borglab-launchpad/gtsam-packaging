+  // stepSize < 1 can never terminate the search: still a configuration error.
+  CHECK_EXCEPTION(DoglegLineSearchImpl::Iterate({0.02, 0.5, 0.5, 1e-3, false},
+                                                dx_u, dx_n, *gbn, fg, config),
+                  std::runtime_error);
+}
