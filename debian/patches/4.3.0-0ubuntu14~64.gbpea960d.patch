+  EXPECT_LONGS_EQUAL(0, estimate.discrete().at(mode.first));
+  EXPECT_DOUBLES_EQUAL(0.5, estimate.nonlinear().at<double>(x1), 1e-6);
+  EXPECT_LONGS_EQUAL(3, dcsam.getNonlinearFactorGraph().nrFactors());
