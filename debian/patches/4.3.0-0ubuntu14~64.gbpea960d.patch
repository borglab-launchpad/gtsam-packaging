+  for (size_t i = 0; i < 12; ++i) {
+    const size_t selectedMode = (i + 1) % 2;
+    // Alternate the accumulated discrete odds between 1e-8 and 1e8, so
+    // the prior dominates the continuous likelihood in either mode.
