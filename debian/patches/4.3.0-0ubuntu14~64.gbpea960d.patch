+  const auto result = model->QR(augmented);
+  EXPECT_LONGS_EQUAL(variables - 5, result->dim());
+  const Vector point = Vector::LinSpaced(variables, -0.1, 0.2);
+  EXPECT(assert_equal(finiteGradient(original, sigmas, point),
