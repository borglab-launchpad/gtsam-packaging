 .github/workflows/prod-cibw.yml                    | 1 +
 .github/workflows/time-sfmbal-benchmark-runner.yml | 6 ++++++
 .github/workflows/vcpkg.yml                        | 1 +
 cmake/GtsamBuildTypes.cmake                        | 9 +++------
 12 files changed, 20 insertions(+), 6 deletions(-)

