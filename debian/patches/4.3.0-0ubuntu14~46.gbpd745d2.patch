+    "                           + (poses[k + 1].y() - route[\"truth\"][k + 1].y())**2)\n",
+    "    print(f\"{floor:6.2f} {np.mean(correct):14.3f} {np.mean(silent):21.3f} {np.sqrt(np.mean(squared)):18.3f}\")"
