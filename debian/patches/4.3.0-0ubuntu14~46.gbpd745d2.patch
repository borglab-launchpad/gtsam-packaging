+                                       {40, 2}, {50, 1}, {90, 1}};
+  const Matrix raw{{2., .7, .2, .1, 0., 0., 0., .6, 0.},
+                   {0., 3., -.3, .4, 0., 0., 0., -.1, 0.},
+                   {0., 0., 1.4, -.2, 0., .5, -.7, .2, 0.},
