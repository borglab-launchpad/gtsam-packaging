+#include <gtsam/nonlinear/Gradients.h>
+
+#include <gtsam/linear/GaussianBayesTree.h>
+#include <gtsam/linear/JacobianFactor.h>
+#include <gtsam/linear/linearExceptions.h>
+#include <gtsam/nonlinear/NonlinearFactorGraph.h>
+
+#include <iostream>
