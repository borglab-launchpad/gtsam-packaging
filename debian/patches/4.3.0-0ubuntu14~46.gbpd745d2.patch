+      rootKey, Vector1{7.}, Matrix11{{2.}}));
+  root->problemSize_ = 100;
+  tree.addClique(root);
+  VectorValues rhs, expected;
+  double sum = 0.;
+  for (Key key = 0; key < 64; ++key) {
