+//*************************************************************************
+// slam_smart_projection: Smart projection factors, kept separate from slam.i
+// to reduce wrapper build memory.
+//*************************************************************************
+
+namespace gtsam {
+
+#include <gtsam/geometry/SimpleCamera.h>
+#include <gtsam/geometry/SphericalCamera.h>
