+  Values initial;
+  initial.insert(x1_key, 2.0);
+  initial.insert(x2_key, -1.0);
+  auto params = scalar_problem::BclParams();
+  const AugmentedLagrangianOptimizer optimizer(problem, initial, params);
+  const Values result = optimizer.optimize();
