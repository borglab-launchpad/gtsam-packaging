+  expectedAdjoint.insert(rootKey, Vector1{rootAdjoint});
+  for (Key key = 0; key < 64; ++key)
+    expectedAdjoint.insert(key, Vector1{rhs.at(key)[0] / 4. - .25 * rootAdjoint});
+  const auto query = [&tree, &rhs, &expected, &expectedAdjoint] {
