+    "fig = go.Figure()\n",
+    "\n",
+    "# Known landmarks\n",
+    "fig.add_trace(\n",
+    "    go.Scatter3d(\n",
+    "        x=landmarks[:, 0],\n",
+    "        y=landmarks[:, 1],\n",
+    "        z=landmarks[:, 2],\n",
+    "        mode=\"markers\",\n",
+    "        marker=dict(size=6),\n",
+    "        name=\"Known Landmarks\",\n",
+    "        hovertemplate=(\n",
+    "            \"Landmark<br>\"\n",
+    "            \"x=%{x:.2f}<br>\"\n",
+    "            \"y=%{y:.2f}<br>\"\n",
+    "            \"z=%{z:.2f}<extra></extra>\"\n",
+    "        ),\n",
+    "    )\n",
+    ")\n",
+    "\n",
+    "# True position\n",
+    "fig.add_trace(\n",
+    "    go.Scatter3d(\n",
+    "        x=[x_true[0]],\n",
+    "        y=[x_true[1]],\n",
+    "        z=[x_true[2]],\n",
+    "        mode=\"markers\",\n",
+    "        marker=dict(size=7),\n",
+    "        name=\"True Position\",\n",
+    "    )\n",
+    ")\n",
+    "\n",
+    "# Initial estimate\n",
+    "fig.add_trace(\n",
+    "    go.Scatter3d(\n",
+    "        x=[x_initial[0]],\n",
+    "        y=[x_initial[1]],\n",
+    "        z=[x_initial[2]],\n",
+    "        mode=\"markers\",\n",
+    "        marker=dict(size=7),\n",
+    "        name=\"Initial Estimate\",\n",
+    "    )\n",
+    ")\n",
+    "\n",
+    "# Optimized estimate\n",
+    "fig.add_trace(\n",
+    "    go.Scatter3d(\n",
+    "        x=[x_estimated[0]],\n",
+    "        y=[x_estimated[1]],\n",
+    "        z=[x_estimated[2]],\n",
+    "        mode=\"markers\",\n",
+    "        marker=dict(size=7),\n",
+    "        name=\"Estimated Position\",\n",
+    "    )\n",
+    ")\n",
+    "\n",
+    "# Localization error line\n",
