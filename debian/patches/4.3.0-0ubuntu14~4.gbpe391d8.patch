+  const Matrix32& B = basis();
+  const Vector3 tangent = B * v;
+  // The tangent basis is orthonormal, so ||B v|| = ||v||.
+  const double thetaSquared = v.squaredNorm();
+  const double theta = std::sqrt(thetaSquared);
